# Cognitive Twin Sub-Agent — environment configuration
# Copy this file to .env and fill in your values.
# python-dotenv loads .env automatically when the app starts.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Options: anthropic | openai | google | agent
# Changing this one variable switches every LLM call in the project.
COGNITIVE_LLM_PROVIDER=agent

# ── Model names ───────────────────────────────────────────────────────────────
# main: used for hypothesis generation (ReasonerAgent) and two-pass critic scoring (CriticAgent)
# fast: used for single-pass helpers — context extraction, honesty detection, honesty rewrite
# COGNITIVE_LLM_MAIN_MODEL=claude-sonnet-4-6
# COGNITIVE_LLM_FAST_MODEL=claude-haiku-4-5-20251001

# OpenAI equivalents (uncomment if COGNITIVE_LLM_PROVIDER=openai):
# COGNITIVE_LLM_MAIN_MODEL=gpt-5-mini
# COGNITIVE_LLM_FAST_MODEL=gpt-5-nano

# Google equivalents (uncomment if COGNITIVE_LLM_PROVIDER=google):
# COGNITIVE_LLM_MAIN_MODEL=gemini-2.0-flash
# COGNITIVE_LLM_FAST_MODEL=gemini-2.0-flash-lite

# ── Sampling ──────────────────────────────────────────────────────────────────
# 0.0 = deterministic (recommended for structured output tasks)
COGNITIVE_LLM_TEMPERATURE=0.0

# ── API keys ──────────────────────────────────────────────────────────────────
# Set only the key for your chosen provider.
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# GOOGLE_API_KEY=your-key-here

# ── LangSmith (optional, for tracing) ─────────────────────────────────────────
# LANGCHAIN_TRACING=false
# LANGSMITH_API_KEY=your-key-here
# LANGSMITH_PROJECT=cognitive-twin
